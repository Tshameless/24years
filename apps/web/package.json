{
  "name": "24years-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/index.ts",
    "start": "node server/index.ts",
    "build": "pnpm type-check && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.vue --max-warnings=0",
    "lint:style": "stylelint \"src/**/*.{css,vue}\"",
    "type-check": "vue-tsc --noEmit && tsc -p server/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:api": "node --test server/*.test.ts",
    "db:backup": "node server/backup-cli.ts backup",
    "db:verify": "node server/backup-cli.ts verify",
    "db:restore": "node server/backup-cli.ts restore",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "pnpm build && playwright test --config=playwright.pwa.config.ts"
  },
  "dependencies": {
    "@lucide/vue": "1.52.0",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.10.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/test-utils": "2.4.6",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-vue": "9.32.0",
    "happy-dom": "20.14.5",
    "postcss-html": "1.7.0",
    "prettier": "3.4.2",
    "stylelint": "16.12.0",
    "typescript": "5.7.2",
    "vite": "6.4.4",
    "vitest": "4.1.11",
    "vue-eslint-parser": "9.4.3",
    "vue-tsc": "2.2.0"
  }
}
