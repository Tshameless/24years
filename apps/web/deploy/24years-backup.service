[Unit]
Description=Create and verify a consistent 24Years database backup
After=24years.service

[Service]
Type=oneshot
User=24years
Group=24years
WorkingDirectory=/opt/24years/apps/web
EnvironmentFile=/etc/24years.env
ExecStart=/usr/bin/node server/backup-cli.ts scheduled
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/24years /var/backups/24years
